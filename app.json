{
  "expo": {
    "name": "Embarque Livre",
    "slug": "embarquelivre",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "embarquelivre",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.fadoni.embarquelivre",
      "infoPlist": {
        "CFBundleDisplayName": "Embarque Livre",
        "NSCameraUsageDescription": "O Embarque Livre usa a câmera para fotografar o animal ao incluí-lo no embarque.",
        "NSPhotoLibraryUsageDescription": "O Embarque Livre acessa suas fotos apenas quando você escolhe da galeria a foto do animal para incluí-lo no embarque."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#1C3C31",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/images/icon.png",
      "package": "com.fadoni.embarquelivre",
      "label": "Embarque Livre"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C3C31",
          "image": "./assets/images/logo-512.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#1C3C31",
            "image": "./assets/images/logo-512.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Embarque Livre usa a câmera para fotografar o animal ao incluí-lo no embarque.",
          "photosPermission": "O Embarque Livre acessa suas fotos apenas quando você escolhe da galeria a foto do animal para incluí-lo no embarque.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
