# Copie para .env e ajuste os hosts conforme o dispositivo.
# URL base da API (sem barra no final; o app acrescenta /api/v1).
# - iOS Simulator: http://localhost:3000 ou o IP do Mac na rede (os dois funcionam).
# - Emulador Android: http://10.0.2.2:3000 (localhost aponta para o próprio emulador) ou o IP do Mac.
# - Aparelho físico: OBRIGATÓRIO o IP do Mac na mesma rede, ex.: http://192.168.1.77:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# PowerSync (offline-first). Token e upload ficam na API: ${EXPO_PUBLIC_API_URL}/api/v1/powersync/{token,upload}.
# Serviço PowerSync (endpoint do SDK). Mesmas regras de host acima (aparelho físico: IP do Mac).
# Precedência: se EXPO_PUBLIC_POWERSYNC_URL estiver definida, ela VENCE o `powersyncUrl` do token.
# Deixe vazia para usar o `powersyncUrl` do token (env POWERSYNC_URL da API; padrão http://localhost:8080).
EXPO_PUBLIC_POWERSYNC_URL=http://localhost:8080
EXPO_PUBLIC_POWERSYNC_TOKEN_PATH=/powersync/token
EXPO_PUBLIC_POWERSYNC_UPLOAD_PATH=/powersync/upload
# requests (PowerSync Service >= 1.24; o compose da API usa 1.28.1) | legacy
EXPO_PUBLIC_POWERSYNC_CHECKPOINT_MODE=requests
